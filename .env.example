NODE_ENV=development
HOST=127.0.0.1
PORT=8443
PUBLIC_ORIGIN=https://localhost:8443
JWT_SECRET=change-this-to-at-least-32-random-bytes-before-production
DATA_DIR=./data
TLS_ENABLED=true
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
MTLS_ENABLED=false
TLS_CA_PATH=./certs/ca.crt
MAX_FILE_BYTES=536870912
DEFAULT_STORAGE_QUOTA_BYTES=2147483648
MIN_FREE_DISK_BYTES=536870912
MAX_ACTIVE_UPLOADS_PER_USER=5
MAX_WS_CONNECTIONS_PER_USER=5
UPLOAD_BYTES_PER_SECOND=10485760
DOWNLOAD_BYTES_PER_SECOND=10485760
TRUST_PROXY=false
REGISTRATION_ENABLED=true
# REGISTRATION_INVITE_CODE=replace-with-a-long-random-code

